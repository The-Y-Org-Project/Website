---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Y.Org — The Y Window System",
  description = "An open-source window system project exploring user-controlled permissions and graphical security.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/image/yorg/Y.Org.png" />
    <meta name="theme-color" content="#101210" />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main class="page">
      <slot />
    </main>

    <Footer />
  </body>
</html>
